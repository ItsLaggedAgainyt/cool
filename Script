-- ---------- Helper ----------
local function makeToggle(name, yPos)
	local box = Instance.new("TextButton")
	box.Size = UDim2.new(0,24,0,24)
	box.Position = UDim2.new(0,10,0,yPos)
	box.BackgroundColor3 = Color3.fromRGB(60,60,60)
	box.Text = ""
	box.Parent = frame
	Instance.new("UICorner", box).CornerRadius = UDim.new(0,6)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0,200,0,24)
	label.Position = UDim2.new(0,40,0,yPos)
	label.BackgroundTransparency = 1
	label.Text = name
	label.Font = Enum.Font.Gotham
	label.TextColor3 = Color3.new(1,1,1)
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	return box
end

-- ---------- ESP Toggles ----------
local enableBtn = makeToggle("Enable X-Ray", 40)
local nameBtn   = makeToggle("Show Names", 70)
local fillBtn   = makeToggle("Show Fill", 100)
local colorBtn  = makeToggle("Color Picker", 130)

local espEnabled = false
local showNames = false
local showFill = false
local highlightColor = Color3.fromRGB(0,255,255)
local highlights = {}
local nameTags = {}

local function toggleButton(btn,state)
	btn.BackgroundColor3 = state and Color3.fromRGB(0,200,0) or Color3.fromRGB(60,60,60)
end

local function createHighlight(character)
	if highlights[character] then return end
	local h = Instance.new("Highlight")
	h.FillTransparency = showFill and 0.5 or 1
	h.OutlineColor = highlightColor
	h.OutlineTransparency = 0
	h.Parent = character
	highlights[character] = h
end

local function removeHighlight(character)
	if highlights[character] then
		highlights[character]:Destroy()
		highlights[character] = nil
	end
end

local function createNameTag(player, character)
	if nameTags[character] then return end
	local head = character:FindFirstChild("Head")
	if not head then return end
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.new(0,100,0,20)
	tag.StudsOffset = Vector3.new(0,2.5,0)
	tag.AlwaysOnTop = true
	tag.Parent = head
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1,0,1,0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = player.Name
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextColor3 = highlightColor
	nameLabel.TextSize = 14
	nameLabel.Parent = tag
	nameTags[character] = tag
end

local function removeNameTag(character)
	if nameTags[character] then
		nameTags[character]:Destroy()
		nameTags[character] = nil
	end
end

local function updateESP()
	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local char = p.Character
			if espEnabled then
				createHighlight(char)
				if highlights[char] then
					highlights[char].FillTransparency = showFill and 0.5 or 1
					highlights[char].OutlineColor = highlightColor
				end
				if showNames then createNameTag(p,char) else removeNameTag(char) end
			else
				removeHighlight(char)
				removeNameTag(char)
			end
		end
	end
end

-- ESP Buttons
enableBtn.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	toggleButton(enableBtn, espEnabled)
	updateESP()
end)
nameBtn.MouseButton1Click:Connect(function()
	showNames = not showNames
	toggleButton(nameBtn, showNames)
	updateESP()
end)
fillBtn.MouseButton1Click:Connect(function()
	showFill = not showFill
	toggleButton(fillBtn, showFill)
	updateESP()
end)
colorBtn.MouseButton1Click:Connect(function()
	highlightColor = Color3.fromRGB(math.random(0,255),math.random(0,255),math.random(0,255))
	updateESP()
end)

Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function()
		task.wait(1)
		updateESP()
	end)
end)
Players.PlayerRemoving:Connect(function(p)
	if p.Character then
		removeHighlight(p.Character)
		removeNameTag(p.Character)
	end
end)

RunService.RenderStepped:Connect(function()
	if espEnabled then updateESP() end
end)

-- ---------- Teleporter ----------
local teleFrame = Instance.new("ScrollingFrame")
teleFrame.Size = UDim2.new(1,-10,0,150)
teleFrame.Position = UDim2.new(0,5,0,170)
teleFrame.BackgroundTransparency = 0.3
teleFrame.BackgroundColor3 = Color3.fromRGB(35,35,35)
teleFrame.CanvasSize = UDim2.new(0,0,0,0)
teleFrame.ScrollBarThickness = 6
teleFrame.Parent = frame

local listLayout = Instance.new("UIListLayout")
listLayout.Parent = teleFrame
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Padding = UDim.new(0,2)

local teleTitle = Instance.new("TextLabel")
teleTitle.Size = UDim2.new(1,0,0,25)
teleTitle.Position = UDim2.new(0,0,0,0)
teleTitle.BackgroundTransparency = 1
teleTitle.Text = "Player Teleporter"
teleTitle.Font = Enum.Font.GothamBold
teleTitle.TextColor3 = Color3.new(1,1,1)
teleTitle.TextSize = 14
teleTitle.Parent = teleFrame

local function refreshTeleList()
	for _,v in pairs(teleFrame:GetChildren()) do
		if v:IsA("TextButton") then v:Destroy() end
	end
	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1,-10,0,25)
			btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
			btn.TextColor3 = Color3.new(1,1,1)
			btn.Text = p.Name
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 14
			btn.Parent = teleFrame
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
			btn.MouseButton1Click:Connect(function()
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					LocalPlayer.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame + Vector3.new(0,3,0)
				end
			end)
		end
	end
	teleFrame.CanvasSize = UDim2.new(0,0,0,listLayout.AbsoluteContentSize.Y)
end

Players.PlayerAdded:Connect(refreshTeleList)
Players.PlayerRemoving:Connect(refreshTeleList)
refreshTeleList()

